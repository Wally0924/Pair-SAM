{
  "permissions": {
    "allow": [
      "Bash(conda run -n sam_env python *)",
      "Bash(conda run -n sam_env pytest *)",
      "Bash(/home/rvl1421/miniconda3/envs/sam_env/bin/python *)",
      "Bash(/home/rvl1421/miniconda3/envs/sam_env/bin/pytest *)",
      "Bash(/home/rvl1421/miniconda3/envs/sam_env/bin/pip install *)",
      "Bash(python -m py_compile *)",
      "Bash(python3 -m py_compile *)",
      "Bash(bash -n *)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:api.github.com)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/rvl1421/SAM_research-1/.claude/hooks/check-python-env.sh",
            "timeout": 10,
            "statusMessage": "檢查 sam_env 規則"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "/home/rvl1421/SAM_research-1/.claude/hooks/py-syntax-check.sh",
            "timeout": 30,
            "statusMessage": "py_compile 語法檢查"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/rvl1421/SAM_research-1/.claude/hooks/stop-test-reminder.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/rvl1421/SAM_research-1/.claude/hooks/session-start.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
